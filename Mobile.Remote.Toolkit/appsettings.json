{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Mobile.Remote.Toolkit": "Information"
    }
  },
  "AllowedHosts": "*",
  "IOS": {
    "Mirror": {
      "Mode": "go-ios-devicekit",
      "GoIosExecutable": "iOS\\go-ios\\ios.exe",
      "Port": 3333,

      "Executable": "iOS\\mirror\\uxplay\\uxplay.exe",
      "Arguments": "-n Mobile-Remote-Toolkit -nh",
      "EnvironmentVariables": {
        "GST_PLUGIN_PATH": "iOS\\mirror\\uxplay\\gstreamer-1.0",
        "GST_REGISTRY": "iOS\\mirror\\uxplay\\registry.bin"
      }
    },
    "DeviceKit": {
      "Executable": "iOS\\go-ios\\ios.exe",
      "BundleId": "com.mobileremotetoolkit.devicekit",
      "Port": 12004,
      "Fps": 30,
      "Quality": 80,

      "BaseIpaPath": "%AppData%\\MobileRemoteToolkit\\DeviceKit.ipa",
      "PreSignedIpaPath": "%AppData%\\MobileRemoteToolkit\\DeviceKit.signed.ipa",

      "AppStoreConnect": {
        "KeyId": "YHT252WGS9",
        "IssuerId": "f91e8ee2-edae-40a1-9117-a333bdb421bb",
        "PrivateKeyPath": "%AppData%\\MobileRemoteToolkit\\AuthKey_YHT252WGS9.p8",
        "BundleId": "com.mobileremotetoolkit.devicekit",
        "CertificateId": "6RU3V96G7L",
        "ProfileName": "MobileRemoteToolkit DeviceKit AdHoc"
      },

      "MacSigner": {
        "Host": "10.90.0.12",
        "Port": 22,
        "Username": "DevStudio",
        "PrivateKeyPath": "%AppData%\\MobileRemoteToolkit\\mac-signer-ssh.key",
        "RemoteWorkDir": "/tmp/devicekit-sign",
        "RemoteScriptPath": "/Users/DevStudio/devicekit/resign-devicekit.sh"
      }
    }
  }
}
