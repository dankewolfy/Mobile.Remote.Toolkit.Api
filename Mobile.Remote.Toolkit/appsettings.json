{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Mobile.Remote.Toolkit": "Information"
    }
  },
  "AllowedHosts": "*",
  "IOS": {
    "Mirror": {
      "Mode": "scheduled-task",
      "StartTaskName": "MobileRemoteToolkit_IosMirror_Start",
      "StopTaskName": "MobileRemoteToolkit_IosMirror_Stop",
      "ProcessName": "IosScreenCaptureTool",

      "Executable": "iOS\\mirror\\uxplay\\uxplay.exe",
      "Arguments": "-n Mobile-Remote-Toolkit -nh",
      "EnvironmentVariables": {
        "GST_PLUGIN_PATH": "iOS\\mirror\\uxplay\\gstreamer-1.0",
        "GST_REGISTRY": "iOS\\mirror\\uxplay\\registry.bin"
      }
    }
  }
}
